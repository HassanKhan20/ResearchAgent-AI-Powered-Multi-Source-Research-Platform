# Postgres (docker-compose sets this automatically). Omit to use local SQLite.
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
# Redis for sessions, event streams and the search cache. Omit for in-memory.
REDIS_URL=redis://localhost:6379/0

# Optional: enables Claude-powered planning, extraction, cross-checking and writing.
# Without it the agents fall back to deterministic heuristics.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Optional: adds Tavily web search alongside Wikipedia and arXiv.
TAVILY_API_KEY=
